# One or more calendars, separated by commas, each optionally named (Name=URL).
# A CalDAV collection (https://cloud.example.com/remote.php/dav/calendars/<user>/<calendar>/),
# a Nextcloud subscription (read through the feed it mirrors), or an ICS feed (?export share, .ics URL).
# CALDAV_URL=Private=https://cloud.example.com/remote.php/dav/calendars/me/personal/,Work=https://cloud.example.com/remote.php/dav/calendars/me/work-subscription/
CALDAV_URL=
CALDAV_USER=
CALDAV_PASSWORD=

# Optional
# ROOM_NAME=Office          # title on the display, defaults to "Calendar"
# TZ=Europe/Berlin          # time zone for display and floating times
# LOCALE=en-GB              # date and time format, e.g. de-DE
# DAYS=7                    # how far ahead the agenda goes, max 31
# REFRESH_MINUTES=5
# SOON_MINUTES=10           # "starting soon" this many minutes before an event
# HIDE_TITLES=false         # show "Busy" instead of event titles
# DASH_PASSWORD=            # basic auth for everything but /api/health
# DASH_USER=                # optional user name for basic auth
